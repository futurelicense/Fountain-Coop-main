# Copy to .env.local (never commit .env.local).
#
# Local CLI (`supabase start`) — defaults match a fresh local stack (use localhost
# so the Next dev server and Supabase URL stay on the same hostname):
#   NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
#
# Hosted Supabase: Dashboard → Project Settings → API → Project URL + anon public key.
# Never pair a Cloud project URL with the local-demo anon key (sign-in will always fail).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo Auth users (run supabase/migrations/002_demo_auth_users.sql first). Password: demo
# Emails: demo-super-admin@fountain.coop, demo-tenant-admin@fountain.coop,
#         demo-group-admin@fountain.coop, demo-member@fountain.coop

# Optional: wallet legacy tokens + `npm run seed:demo-auth` (server only; never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=

# Paystack (server-side only). Required for member deposit checkout/verification.
# PAYSTACK_SECRET_KEY=
# Optional explicit app origin used in Paystack callback URL construction
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: separate origin for custom Next API routes
# NEXT_PUBLIC_API_URL=
