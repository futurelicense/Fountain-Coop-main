# Copy to .env.local (never commit .env.local).
#
# Hosted Supabase: Dashboard → Project Settings → API → Project URL + anon public key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Wired / live Paystack test (recommended)
NEXT_PUBLIC_WIRED_TEST_MODE=true
NEXT_PUBLIC_LEGACY_AUTH_ENABLED=false

# Server-only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Paystack test secret (sk_test_…) — must match the public key mode you use at checkout
PAYSTACK_SECRET_KEY=

# Callback + webhook base URL (use ngrok for local Paystack webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo users: npm run seed:demo-auth  (password: demo)
#   demo-member@fountain.coop  — use this email for Paystack wallet tests (not FC-1001 alone)
#   demo-super-admin@fountain.coop, demo-tenant-admin@fountain.coop, demo-group-admin@fountain.coop

# Clear mock DB data before wired test:
#   Run supabase/migrations/008_clear_mock_data_wired_test.sql  OR  npm run reset:wired-test
#
# Paystack Dashboard → Webhooks → POST https://YOUR_HOST/api/webhooks/paystack
